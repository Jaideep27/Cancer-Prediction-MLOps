# Everything listed here is NOT sent to Docker as build context.
# Smaller context = faster builds, and no secrets or junk can end up in the image.
venv/
.venv/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
mlruns/
mlartifacts/
mlflow.db
data/
tests/
infrastructure/
artifacts/metrics/
.env
*.md
